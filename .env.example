# Copy to .env and fill in. Never commit .env.
# Inside Replit you do not need a .env: Replit provides DATABASE_URL and the
# AI_INTEGRATIONS_* variables itself, and real environment variables win over .env.

# Replit Database (Postgres). Replit → Tools → Database → connection string.
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Replit-managed OpenAI (Replit AI Integrations). Set automatically inside the
# Repl and its deployments. There is no fallback to another provider.
# AI_INTEGRATIONS_OPENAI_BASE_URL=
# AI_INTEGRATIONS_OPENAI_API_KEY=

# Optional OpenAI model id (default gpt-5-mini). Must support strict
# structured outputs (json_schema) and reasoning_effort "minimal".
# AI_MODEL=gpt-5-mini
