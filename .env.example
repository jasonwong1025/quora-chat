# Copy to .env and fill in. Never commit .env.
# Inside Replit you do not need a .env: Replit provides DATABASE_URL and the
# AI_INTEGRATIONS_* variables itself, and real environment variables win over .env.

# Replit Database (Postgres). Replit → Tools → Database → connection string.
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Local: OpenRouter API key (https://openrouter.ai/keys).
OPENROUTER_API_KEY=

# On Replit, Replit-managed OpenAI (AI_INTEGRATIONS_OPENAI_BASE_URL and
# AI_INTEGRATIONS_OPENAI_API_KEY) is set automatically and is used first.

# Optional model id. Must support structured outputs (json_schema) and
# reasoning_effort "minimal". Defaults: openai/gpt-5-mini on OpenRouter,
# gpt-5-mini on Replit-managed OpenAI. Leave unset when switching between them.
# AI_MODEL=

# Optional OpenAI-compatible endpoint override for OpenRouter (used by isolated tests).
# AI_BASE_URL=https://openrouter.ai/api/v1
