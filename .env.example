# Copy to .env and fill in. Never commit .env.

# Replit Database (Postgres). Replit → Tools → Database → connection string.
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Replit AI Integrations (OpenAI-compatible). Replit sets these automatically
# inside a Repl; copy them here for local dev.
AI_INTEGRATIONS_OPENAI_BASE_URL=
AI_INTEGRATIONS_OPENAI_API_KEY=

# Optional local fallback if Replit AI isn't reachable from your machine.
# Used only when the AI_INTEGRATIONS_* values above are empty.
OPENAI_API_KEY=

# Model used for parsing and drafting.
AI_MODEL=gpt-5-mini
