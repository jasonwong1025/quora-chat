run = "pnpm dev"
modules = ["web", "python-3.12", "nodejs-22", "postgresql-16"]

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
deploymentTarget = "vm"
build = ["sh", "-c", "CI=true pnpm install --frozen-lockfile && pnpm build"]
# Replit's Publish flow manages production schema changes.
run = ["sh", "-c", "pnpm start:with-worker"]

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"
